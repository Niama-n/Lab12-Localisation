<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="@color/nma_background"
    android:padding="24dp"
    android:id="@+id/nma_rootContainer">

    <!-- App logo / icon area -->
    <TextView
        android:text="📍"
        android:textSize="56sp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- App title -->
    <TextView
        android:text="Localisation GPS"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/nma_primary"
        android:layout_marginBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Subtitle -->
    <TextView
        android:text="Real-time position tracking"
        android:textSize="13sp"
        android:textColor="@color/nma_subtleText"
        android:layout_marginBottom="28dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Coordinates card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:elevation="4dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/nma_cardSurface">

        <LinearLayout
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Current Coordinates"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textColor="@color/nma_subtleText"
                android:layout_marginBottom="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/nma_latitudeText"
                android:text="Latitude: —"
                android:textSize="19sp"
                android:textColor="@color/nma_darkText"
                android:drawablePadding="8dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/nma_background"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/nma_longitudeText"
                android:text="Longitude: —"
                android:textSize="19sp"
                android:textColor="@color/nma_darkText"
                android:drawablePadding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Status indicator -->
    <TextView
        android:text="⏳ Waiting for GPS signal…"
        android:textSize="12sp"
        android:textColor="@color/nma_subtleText"
        android:layout_marginBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Map navigation button -->
    <Button
        android:id="@+id/nma_showMapButton"
        android:text="🗺️  View Map"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/nma_accent"
        android:paddingVertical="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>